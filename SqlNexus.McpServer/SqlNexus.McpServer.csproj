<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SqlNexus.McpServer</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Strong-named with the shared SqlNexus key so this assembly can grant InternalsVisibleTo to
         the (strong-named) unit test project: a signed assembly can only expose its internals to a
         strong-named friend, and the friend grant must carry that friend's PublicKey (see
         Properties\AssemblyInfo.cs). This is the only reason signing is required here - a
         strong-named assembly can still reference/load a weak-named one at runtime; that merely
         produces the CS8002 warning, which the test project already suppresses via NoWarn. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\sqlnexus\SqlNexus.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <PreBuildEvent>powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\GenerateFileHashes.ps1"</PreBuildEvent>
  </PropertyGroup>
</Project>
